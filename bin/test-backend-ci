#!/bin/bash -x
declare lr=">>>>>>>>"

log() {
    echo "$lr $*"
}

# The backend test files CI runs: top-level src files, the app directories, and tools.
list_test_files() {
    ./node_modules/.bin/jest --listTests 2>/dev/null \
        | sed "s#^$(pwd)/##" \
        | grep -E '^src/[^/]+\.(js|ts)$|^src/(lib|middleware|models|policies|routes|scopes|services|widgets|goalServices)/|^(src/)?tools/' \
        | sort
}

main(){
    export JEST_JUNIT_OUTPUT_DIR=reports
    export JEST_JUNIT_OUTPUT_NAME=backend.xml
    export JEST_JUNIT_ADD_FILE_ATTRIBUTE=true
    export POSTGRES_USERNAME=postgres
    export POSTGRES_DB=ttasmarthub
    export CURRENT_USER_ID=5
    export CI=true

    local all_tests_file=reports/backend-all-tests.txt
    local selected_tests_file=reports/backend-selected-tests.txt
    mkdir -p reports

    list_test_files > "$all_tests_file"
    log "Found $(wc -l < "$all_tests_file" | tr -d ' ') backend test files"

    # an empty list means listing failed, not that there is nothing to test
    if [[ ! -s "$all_tests_file" ]]; then
        log "No backend test files found; jest --listTests output:"
        ./node_modules/.bin/jest --listTests
        exit 1
    fi

    # Split by file so CircleCI can balance nodes with per-file timings from earlier runs.
    # Paths are relative to the repo root to match the file attribute jest-junit records.
    if [[ -n "$CIRCLE_NODE_TOTAL" && "$CIRCLE_NODE_TOTAL" -gt 1 ]] && command -v circleci >/dev/null 2>&1; then
        circleci tests split --split-by=timings --timings-type=filename --time-default=10s \
            < "$all_tests_file" > "$selected_tests_file"
    else
        cp "$all_tests_file" "$selected_tests_file"
    fi

    local -a selected_tests=()
    while IFS= read -r test_file; do
        selected_tests+=("$test_file")
    done < "$selected_tests_file"
    log "Running ${#selected_tests[@]} backend test files on node ${CIRCLE_NODE_INDEX:-0}/${CIRCLE_NODE_TOTAL:-1}"

    if [[ ${#selected_tests[@]} -eq 0 ]]; then
        log "No backend tests selected for this node"
        exit 0
    fi

    # Coverage covers the same files as before so the merged report stays comparable.
    # Thresholds are checked on the merged report in tests_done, not per node.
    # One worker runs the files one at a time and is restarted once its heap passes 1GB;
    # a single long-lived process grew past 2GB and slowed every node to a crawl.
    touch coverage-expected
    node \
        --expose-gc \
        ./node_modules/.bin/jest \
        --runTestsByPath "${selected_tests[@]}" \
        --coverage \
        --coverageDirectory="$(pwd)"/coverage/src/backend \
        --collectCoverageFrom='src/*.{js,ts}' \
        --collectCoverageFrom='src/{lib,middleware,models,policies,routes,scopes,services,widgets,goalServices}/**/!(*CLI).{js,ts}' \
        --coverageThreshold='{}' \
        --colors \
        --reporters=jest-junit \
        --reporters=default \
        --verbose \
        --testLocationInResults \
        --maxWorkers=1 \
        --workerIdleMemoryLimit=1GB \
        --silent \
        --logHeapUsage \
        --forceExit
    local exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        echo
        log "Errors occurred during script execution"
    fi

    exit "$exit_code"
}

main
