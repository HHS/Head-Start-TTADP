#!/bin/bash
#
# start-node: launch a Node.js process, optionally capping the V8 old-space
# heap to a value provided by the environment.
#
# The deployed web and worker processes otherwise run `node <entrypoint>` with
# V8's default heap sizing, which does not account for the container's memory
# limit. After the Node 22 -> 24 upgrade the higher baseline RSS pushes the
# smaller instances (e.g. the 512 MB worker) over their limit at boot, so the
# platform OOM-kills them (exit 137) in a crash loop.
#
# The per-process memory limits are already fixed in deployment_config/*_vars.yml,
# so the heap size is passed in via NODE_MAX_OLD_SPACE_SIZE (set per process in
# manifest.yml) rather than computed here. When it is unset (local dev, CI), the
# process starts with Node's defaults.
#
# Usage: bin/start-node <path-to-js> [args...]

set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "Usage: bin/start-node <path-to-js> [args...]" >&2
  exit 1
fi

if [ -n "${NODE_MAX_OLD_SPACE_SIZE:-}" ]; then
  echo "start-node: --max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" >&2
  exec node "--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" "$@"
fi

echo "start-node: NODE_MAX_OLD_SPACE_SIZE unset, using node defaults" >&2
exec node "$@"
