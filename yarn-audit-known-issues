sulting in excessive cpu and memory consumption.","reported_by":null,"title":"minimatch has potential denial of service via globparts amplification","metadata":null,"cves":["CVE-2026-118764"],"access":"public","severity":"moderate","module_name":"minimatch","vulnerable_versions":"<11.0.1","github_advisory_id":"GHSA-g3hv-75wg-m249","recommendation":"Upgrade to version 11.0.1 or later","patched_versions":">=11.0.1","updated":"2026-10-30T23:09:56.000Z","cvss":{"score":0,"vectorString":null},"cwe":["CWE-405"],"url":"https://github.com/advisories/GHSA-g3hv-75wg-m249"}}}
