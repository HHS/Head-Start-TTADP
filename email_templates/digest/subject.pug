case type
    when 'collaboratorDigest'
        = `TTA Hub ${subjectFreq} digest: added as collaborator`
    when 'changesRequestedDigest'
        = `TTA Hub ${subjectFreq} digest: changes requested`
    when 'approverAssignedDigest'
        = `TTA Hub ${subjectFreq} digest: Activity reports for approval`
    when 'reportApprovedDigest'
        = `TTA Hub ${subjectFreq} digest: approved reports`
    when 'recipientReportApprovedDigest'
        = `TTA Hub ${subjectFreq} digest: Your recipients' approved Activity Reports`
    when 'collaboratorReportSubmittedForReviewDigest'
        = `TTA Hub ${subjectFreq} digest: Activity Reports submitted for approval`
    when 'creatorReportSubmittedForReviewDigest'
        = `TTA Hub ${subjectFreq} digest: Activity Reports submitted for approval`
    when 'trainingReportPocAddedDigest'
        = `TTA Hub ${subjectFreq} digest: added as a regional point of contact`
    when 'trainingReportCollaboratorAddedDigest'
        = `TTA Hub ${subjectFreq} digest: added as an Event Collaborator`
    when 'trainingReportSessionSubmittedDigest'
        = `TTA Hub ${subjectFreq} digest: session submitted for review`
    default
        = `TTA Hub digest: ${type}`

