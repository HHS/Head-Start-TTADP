p Hello #{user.name},
if type === 'monitoringDetailsAddedDigest'
    p Below are your monitoring notifications for #{freq}.
else if type === 'trainingReportSessionSubmittedDigest'
    p Below are your report notifications for #{freq}.
    p Select the session name to view it in the Hub.
else if type === 'trainingReportSessionNeedsActionDigest'
    p Below are your report notifications for #{freq}.
    p Select the session name to view it in the Hub.
else
    p Below are your report notifications for #{freq}.
    p Select the report number to view it in the Hub.
case type
    when 'collaboratorDigest'
        p You were added as a collaborator on these activity reports:
    when 'changesRequestedDigest'
        p Changes were requested to these activity reports:
    when 'approverAssignedDigest'
        p These activity reports were submitted for your approval:
    when 'reportApprovedDigest'
        p These activity reports were approved:
    when 'recipientReportApprovedDigest'
        p Activity Reports associated with your recipients were approved:
    when 'collaboratorReportSubmittedForReviewDigest'
        p The following Activity Reports, on which you are a collaborator, have been submitted for approval:
    when 'creatorReportSubmittedForReviewDigest'
        p The following Activity Reports, on which you are a creator, have been submitted for approval:
    when 'trainingReportPocAddedDigest'
        p You were added as a regional point of contact on these Training Reports:
    when 'trainingReportCollaboratorAddedDigest'
        p You were added as an Event Collaborator on these Training Reports:
    when 'trainingReportSessionSubmittedDigest'
        p The following sessions were submitted for review:
    when 'trainingReportSessionNeedsActionDigest'
        p Changes have been requested for the following sessions:
    when 'monitoringDetailsAddedDigest'
        p New monitoring reports were added in your region for the following recipients:
    default
        p
ul
  for report in reports
    li
      a(href=report.link)= report.displayId
if type !== 'monitoringDetailsAddedDigest'
    p That's it!
p Best wishes,
  br
  | The TTA Hub team
