case type
    when 'collaboratorDigest'
        = `TTA Hub ${subjectFreq} digest: no new collaborator notifications`
    when 'changesRequestedDigest'
        = `TTA Hub ${subjectFreq} digest: no new changes requested`
    when 'approverAssignedDigest'
        = `TTA Hub ${subjectFreq} digest: no new reports for approval`
    when 'reportApprovedDigest'
        = `TTA Hub ${subjectFreq} digest: no new approved reports`
    when 'recipientReportApprovedDigest'
        = `TTA Hub ${subjectFreq} digest: no new approved reports`
    when 'collaboratorReportSubmittedForReviewDigest'
        = `TTA Hub ${subjectFreq} digest: no new reports submitted for approval`
    when 'creatorReportSubmittedForReviewDigest'
        = `TTA Hub ${subjectFreq} digest: no new reports submitted for approval`
    default
        = `TTA Hub digest: ${type}`
