#!/usr/bin/env bash
set -euo pipefail

collect_staged_files() {
  while IFS= read -r -d '' file; do
    staged_files+=("$file")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)
}

validate_circleci_config() {
  if [[ -x "$(command -v circleci)" ]]; then
    circleci config validate > /dev/null
  fi
}

# Blocks commits that would add forbidden data or log-leaking commands. These are the same checks CI runs,
# run here so the problem is caught before it reaches a commit or a PR. Neither check prints the offending
# text, because it could be PII or a secret.
#
# This must run after the final `git add` in main: that re-stages the whole working-tree copy of every
# staged file (including unstaged edits), so only the finished index is what will be committed. Both checks
# read the index, never the working tree.
run_safety_checks() {
  # HSES data files and staff email addresses in data files, checked against what is staged.
  if [ -f tools/validate-data-file-guard.js ]; then
    if ! guard_output=$(node tools/validate-data-file-guard.js --staged 2>&1); then
      echo "$guard_output"
      echo "ERROR: the data file guard failed on the staged changes. Remove the data from the commit (git restore --staged <file>)."
      exit 1
    fi
  fi

  # Commands that print the environment or secret values. CircleCI logs are public, so these leak.
  # Only run when something the check reads is staged.
  if [ -f tools/checkSecretPrinting.js ]; then
    local relevant=false
    for file in "${staged_files[@]}"; do
      case "$file" in
        automation/*|bin/*|.circleci/config.yml|tools/checkSecretPrinting.js|tools/secretPrintingExceptions.json)
          relevant=true
          break
          ;;
      esac
    done

    if [ "$relevant" = true ] && ! secret_output=$(node tools/checkSecretPrinting.js --staged 2>&1); then
      echo "$secret_output"
      echo "ERROR: a script or CI config would print the environment or secret values. See docs/guides/circle-ci.md#secret-printing-check."
      exit 1
    fi
  fi
}

format_terraform_file() {
  local file=$1
  
  if [[ -x "$(command -v terraform)" ]]; then
    printf "Running: 'terraform fmt' on %s\n\n" "$file"
    terraform fmt "$file"
  fi
}

validate_common_versioning() {
  local common_changed=$1
  local common_package_json_changed=$2
  local frontend_yarn_lock_changed=$3
  local backend_yarn_lock_changed=$4

  if [ "$common_changed" != true ]; then
    return 0
  fi

  if [ "$common_package_json_changed" != true ]; then
    echo "ERROR: common/src/index.js was changed, but common/package.json was not updated. Please make sure to publish a new version."
    exit 1
  fi

  if [ "$frontend_yarn_lock_changed" != true ] || [ "$backend_yarn_lock_changed" != true ]; then
    echo "ERROR: common/src/index.js was changed, but a yarn.lock file was not updated. Please make sure you've updated both yarn.lock files if you've updated the common/index.js file."
    exit 1
  fi
}

main() {
  staged_files=()
  collect_staged_files

  if [ ${#staged_files[@]} -eq 0 ]; then
    exit 0
  fi

  validate_circleci_config

  common_changed=false
  common_package_json_changed=false
  frontend_yarn_lock_changed=false
  backend_yarn_lock_changed=false
  biome_files=()

  for file in "${staged_files[@]}"; do

    if [ ! -e "$file" ]; then
      continue
    fi

    case "$file" in
      packages/common/src/index.js)
        common_changed=true
        ;;
      packages/common/package.json)
        common_package_json_changed=true
        ;;
      frontend/yarn.lock)
        frontend_yarn_lock_changed=true
        ;;
      yarn.lock)
        backend_yarn_lock_changed=true
        ;;
    esac

    case "$file" in
      *.tf)
        format_terraform_file "$file"
        ;;
      *)
        biome_files+=("$file")
        ;;
    esac
  done

  if [ ${#biome_files[@]} -gt 0 ]; then
    yarn lint:fix "${biome_files[@]}"
  fi

  git add -- "${staged_files[@]}"

  run_safety_checks

  validate_common_versioning \
    "$common_changed" \
    "$common_package_json_changed" \
    "$frontend_yarn_lock_changed" \
    "$backend_yarn_lock_changed"
}

main